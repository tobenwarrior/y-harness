{
  "name": "@yharness/skill-library",
  "description": "Project skill inventory and reversible managed maintenance",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/skill/skill-library"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@yharness/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/brand": "workspace:*",
    "@yharness/home-paths": "workspace:*",
    "@yharness/skill": "workspace:*",
    "@yharness/skill-filesystem": "workspace:*",
    "@yharness/storage-domain": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/workspace": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/agent": "workspace:*",
    "@yharness/agent-preset-registry": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/util-values": "workspace:*"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/brand": "workspace:*",
    "@yharness/home-paths": "workspace:*",
    "@yharness/skill": "workspace:*",
    "@yharness/skill-filesystem": "workspace:*",
    "@yharness/storage-domain": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/workspace": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/agent": "workspace:*",
    "@yharness/agent-preset-registry": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/util-values": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@yharness/agent": {
      "optional": true
    },
    "@yharness/agent-preset-registry": {
      "optional": true
    },
    "@yharness/tools": {
      "optional": true
    },
    "@yharness/llm": {
      "optional": true
    },
    "@yharness/session": {
      "optional": true
    }
  }
}

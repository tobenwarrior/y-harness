{
  "name": "@deepseek-ai/dsh-coding-session",
  "description": "Source-labelled native coding-session discovery, durable mirrors, and explicit sequential handoff",
  "version": "0.2.1-alpha.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/coding-session"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./claude-source": {
      "types": "./lib/types/claude-source.d.ts",
      "default": "./lib/types/claude-source.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-storage-domain": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/dsh-workspace": "workspace:*",
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-subagent-claude-code": "workspace:*",
    "@deepseek-ai/dsh-skill-library": "workspace:*",
    "@deepseek-ai/dsh-session-persistence": "workspace:*"
  },
  "dependencies": {
    "@deepseek-ai/dsh-brand": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@deepseek-ai/dsh-llm": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-storage-domain": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/dsh-storage": "workspace:*",
    "@deepseek-ai/dsh-storage-json": "workspace:*",
    "@deepseek-ai/dsh-typert-registry": "workspace:*",
    "@deepseek-ai/dsh-workspace": "workspace:*",
    "@deepseek-ai/dsh-subprocess": "workspace:*",
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-subagent-claude-code": "workspace:*",
    "@deepseek-ai/dsh-skill-library": "workspace:*",
    "@deepseek-ai/dsh-session-persistence": "workspace:*",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:*",
    "@deepseek-ai/dsh-session-projection": "workspace:*",
    "@deepseek-ai/dsh-agent-loop": "workspace:*",
    "@deepseek-ai/dsh-system-prompt": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent-claude-code": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill-library": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    }
  }
}

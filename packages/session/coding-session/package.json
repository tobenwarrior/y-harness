{
  "name": "@yharness/coding-session",
  "description": "Source-labelled native coding-session discovery, durable mirrors, and explicit sequential handoff",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/session/coding-session"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./claude-source": {
      "types": "./lib/types/claude-source.d.ts",
      "default": "./lib/types/claude-source.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/storage-domain": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/workspace": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/agent": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/subagent-claude-code": "workspace:*",
    "@yharness/skill-library": "workspace:*",
    "@yharness/session-persistence": "workspace:*"
  },
  "dependencies": {
    "@yharness/brand": "workspace:*",
    "@yharness/schemastery": "workspace:~",
    "zod": "^4.4.3",
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@yharness/llm": "workspace:*"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/storage-domain": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/cordis-plugin-include": "workspace:~",
    "@yharness/cordis-plugin-loader": "workspace:~",
    "@yharness/storage": "workspace:*",
    "@yharness/storage-json": "workspace:*",
    "@yharness/typert-registry": "workspace:*",
    "@yharness/workspace": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/agent": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/subagent-claude-code": "workspace:*",
    "@yharness/skill-library": "workspace:*",
    "@yharness/session-persistence": "workspace:*",
    "@yharness/session-persistence-jsonl": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/agent-loop": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/tools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@yharness/agent": {
      "optional": true
    },
    "@yharness/session": {
      "optional": true
    },
    "@yharness/subagent-claude-code": {
      "optional": true
    },
    "@yharness/skill-library": {
      "optional": true
    },
    "@yharness/session-persistence": {
      "optional": true
    }
  }
}

{
  "name": "@yharness/session-telemetry",
  "description": "SessionTelemetryBackend seam for the Y Harness: session-event capture, projection, redaction, and handoff to a reporting backend",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/session/session-telemetry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/agent": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@yharness/agent": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/cordis": "workspace:~"
  }
}

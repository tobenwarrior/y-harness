{
  "name": "@yharness/session-log-deepseek",
  "description": "Incremental lossless session-log request extension for the official DeepSeek LLM API",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/session/session-log-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@yharness/brand": "workspace:*",
    "@yharness/util-values": "workspace:*",
    "@yharness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/deepseek-llm-api-extensions": "workspace:*",
    "@yharness/session": "workspace:*"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/cordis-plugin-include": "workspace:~",
    "@yharness/cordis-plugin-loader": "workspace:~",
    "@yharness/command-feedback": "workspace:*",
    "@yharness/deepseek-llm-api-extensions": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/llm-deepseek": "workspace:*",
    "@yharness/llm-deepseek-api-key": "workspace:*",
    "@yharness/llm-mock-server": "workspace:*",
    "@yharness/message-feedback": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-persistence-jsonl": "workspace:*"
  }
}

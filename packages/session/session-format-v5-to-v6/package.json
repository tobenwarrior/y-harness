{
  "name": "@yharness/session-format-v5-to-v6",
  "description": "Native Session V6 codec and identity migration from Session V5",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/session/session-format-v5-to-v6"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "sessionFormatMigration": {
      "from": 5,
      "to": 6,
      "export": ".",
      "migration": "sessionFormatV5ToV6",
      "sourceCodec": "releasedV5SessionFormatCodec",
      "targetCodec": "releasedV6SessionFormatCodec",
      "targetHeaderValidator": "assertReleasedV6Header",
      "targetRestorer": "restoreReleasedV6Artifact"
    }
  },
  "dependencies": {
    "@yharness/session-format": "workspace:*",
    "@yharness/session-format-v4-to-v5": "workspace:*"
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~"
  }
}

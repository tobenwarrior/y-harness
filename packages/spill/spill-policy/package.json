{
  "name": "@yharness/spill-policy",
  "description": "Token-budgeted tool-result retention with recoverable text and image paths",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./notice": {
      "types": "./lib/types/notice.d.ts",
      "default": "./lib/types/notice.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/llm": "workspace:*",
    "@yharness/output-retention": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/spill": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/cordis": "workspace:~",
    "@yharness/attachment": "workspace:*",
    "@yharness/fs": "workspace:*",
    "@yharness/token-meter": "workspace:*"
  },
  "dependencies": {
    "@yharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@yharness/agent": "workspace:*",
    "@yharness/ptc-runtime-node": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/output-retention": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/spill": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/cordis": "workspace:~",
    "@yharness/fs-local": "workspace:*",
    "@yharness/subprocess-local": "workspace:*",
    "@yharness/sandbox-local": "workspace:*",
    "@yharness/sandbox-policy": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/attachment": "workspace:*",
    "@yharness/fs": "workspace:*",
    "@yharness/token-meter": "workspace:*",
    "@yharness/mcp-client": "workspace:*",
    "@yharness/spill-local": "workspace:*",
    "@yharness/llm-deepseek": "workspace:*",
    "@yharness/ptc-runtime": "workspace:*",
    "@yharness/attachment-local": "workspace:*",
    "@yharness/tool-fs": "workspace:*",
    "sharp": "^0.35.3"
  }
}

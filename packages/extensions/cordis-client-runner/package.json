{
  "name": "@yharness/cordis-client-runner",
  "description": "Browser half of dynamic dual-half plugin packages: event subscription, closure evaluation, guard facade, and loader entries",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/extensions/cordis-client-runner"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@yharness/client-ui-renderer",
        "@yharness/api-remotes",
        "@yharness/client-modules",
        "@yharness/client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@yharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@yharness/cordis-plugin-loader": "workspace:~",
    "@yharness/api-remotes": "workspace:*",
    "@yharness/client-modules": "workspace:*",
    "@yharness/client-ui-renderer": "workspace:*",
    "@yharness/client-ui-theme": "workspace:*",
    "@types/react": "~18.3.1",
    "@yharness/cordis": "workspace:~",
    "react": "^18.2.0",
    "@yharness/util-values": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}

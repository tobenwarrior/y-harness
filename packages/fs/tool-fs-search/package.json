{
  "name": "@yharness/tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@yharness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@yharness/llm": "workspace:*",
    "@yharness/output-retention": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/spill": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/timeout": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@yharness/agent": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/subprocess-local": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/output-retention": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/spill": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/timeout": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/cordis": "workspace:~",
    "@yharness/scope": "workspace:*"
  }
}

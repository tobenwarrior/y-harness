{
  "name": "@yharness/api-terminal-controller",
  "description": "Session-owned interactive terminals with shell discovery, screen recovery and typed Remote control",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/api/terminal-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@yharness/api-gateway"
      ],
      "external": [
        "@yharness/api-gateway/client"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@yharness/deque": "workspace:*",
    "@yharness/lazy-require": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/schemastery": "workspace:~",
    "@xterm/headless": "^6.0.0",
    "@xterm/addon-serialize": "^0.14.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@yharness/subprocess": "workspace:*",
    "@yharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/api-gateway": "workspace:*",
    "@yharness/brand": "workspace:*",
    "@yharness/client-store": "workspace:*",
    "@yharness/fs": "workspace:*",
    "@yharness/remote-mock": "workspace:*",
    "@yharness/sandbox": "workspace:*",
    "@yharness/sandbox-policy": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/subprocess-local": "workspace:*",
    "@yharness/util-crypto": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ]
}

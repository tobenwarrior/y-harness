{
  "name": "@yharness/api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "external": [
        "@yharness/api-gateway/client"
      ],
      "inject": [
        "@yharness/api-gateway",
        "@yharness/client-file-upload"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@yharness/brand": "workspace:*",
    "@yharness/deque": "workspace:*",
    "@yharness/schemastery": "workspace:~",
    "mime-types": "^3.0.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/agent-default-model": "workspace:*",
    "@yharness/agent-preset-registry": "workspace:*",
    "@yharness/api-gateway": "workspace:*",
    "@yharness/attachment": "workspace:*",
    "@yharness/client-connection": "workspace:*",
    "@yharness/client-file-upload": "workspace:*",
    "@yharness/commands": "workspace:*",
    "@yharness/credentials": "workspace:*",
    "@yharness/file-reference": "workspace:*",
    "@yharness/fs": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/native-command": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-persistence": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/session-projection-cache": "workspace:*",
    "@yharness/session-query": "workspace:*",
    "@yharness/session-title": "workspace:*",
    "@yharness/settings": "workspace:*",
    "@yharness/skill": "workspace:*",
    "@yharness/subagent": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/typert-registry": "workspace:*",
    "@yharness/util-time": "workspace:*",
    "@yharness/util-values": "workspace:*",
    "@yharness/util-workspace-path": "workspace:*",
    "@yharness/workspace": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@yharness/session-persistence": {
      "optional": true
    },
    "@yharness/session-projection-cache": {
      "optional": true
    },
    "@yharness/settings": {
      "optional": true
    }
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/agent-default-model": "workspace:*",
    "@yharness/agent-loop": "workspace:*",
    "@yharness/agent-loop-testkit": "workspace:*",
    "@yharness/agent-preset-registry": "workspace:*",
    "@yharness/api-gateway": "workspace:*",
    "@yharness/attachment": "workspace:*",
    "@yharness/client-connection": "workspace:*",
    "@yharness/client-file-upload": "workspace:*",
    "@yharness/client-store": "workspace:*",
    "@yharness/client-test-runtime": "workspace:*",
    "@yharness/commands": "workspace:*",
    "@yharness/credentials": "workspace:*",
    "@yharness/file-reference": "workspace:*",
    "@yharness/fs": "workspace:*",
    "@yharness/fs-local": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/native-command": "workspace:*",
    "@yharness/permission-presets": "workspace:*",
    "@yharness/remote-mock": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-persistence": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/session-projection-cache": "workspace:*",
    "@yharness/session-query": "workspace:*",
    "@yharness/session-title": "workspace:*",
    "@yharness/settings": "workspace:*",
    "@yharness/skill": "workspace:*",
    "@yharness/storage": "workspace:*",
    "@yharness/storage-domain": "workspace:*",
    "@yharness/storage-json": "workspace:*",
    "@yharness/subagent": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/typert-registry": "workspace:*",
    "@yharness/util-crypto": "workspace:*",
    "@yharness/util-time": "workspace:*",
    "@yharness/util-values": "workspace:*",
    "@yharness/util-workspace-path": "workspace:*",
    "@yharness/workspace": "workspace:*",
    "@types/mime-types": "^3.0.1"
  }
}

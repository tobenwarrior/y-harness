{
  "name": "@yharness/api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@yharness/api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@yharness/deque": "workspace:*",
    "@yharness/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/scope": "workspace:*"
  },
  "devDependencies": {
    "@yharness/agent": "workspace:*",
    "@yharness/agent-preset-registry": "workspace:*",
    "@yharness/api-gateway": "workspace:*",
    "@yharness/api-job-controller": "workspace:*",
    "@yharness/api-session-controller": "workspace:*",
    "@yharness/api-settings-controller": "workspace:*",
    "@yharness/api-workspace-controller": "workspace:*",
    "@yharness/api-workspace-files": "workspace:*",
    "@yharness/client-connection": "workspace:*",
    "@yharness/client-file-upload": "workspace:*",
    "@yharness/commands": "workspace:*",
    "@yharness/cordis-host-runner": "workspace:*",
    "@yharness/credentials": "workspace:*",
    "@yharness/file-reference": "workspace:*",
    "@yharness/goal": "workspace:*",
    "@yharness/host-plugin-inventory": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/message-feedback": "workspace:*",
    "@yharness/permission-presets": "workspace:*",
    "@yharness/schedule": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/session-reference": "workspace:*",
    "@yharness/settings": "workspace:*",
    "@yharness/subagent": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/user-approval": "workspace:*",
    "@yharness/user-questions": "workspace:*",
    "@yharness/cordis": "workspace:~",
    "zod": "^4.4.3",
    "@yharness/command-feedback": "workspace:*",
    "@yharness/api-terminal-controller": "workspace:*",
    "@yharness/plugin-manager": "workspace:*",
    "@yharness/client-ui-plugin-manager": "workspace:*",
    "@yharness/office-to-pdf": "workspace:*",
    "@yharness/api-account-controller": "workspace:*",
    "@yharness/deepseek-account": "workspace:*",
    "@yharness/client-product-analytics": "workspace:*",
    "@yharness/llm-pi-ai": "workspace:*",
    "@yharness/skill-library": "workspace:*",
    "@yharness/coding-session": "workspace:*"
  }
}

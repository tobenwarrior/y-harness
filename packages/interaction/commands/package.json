{
  "name": "@yharness/commands",
  "description": "Plugin-owned human command registry for Y Harness UIs",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/interaction/commands"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./brand": {
      "types": "./lib/types/brand.d.ts",
      "default": "./lib/types/brand.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/agent": "workspace:*",
    "@yharness/attachment": "workspace:*",
    "@yharness/brand": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/cordis": "workspace:~"
  },
  "dependencies": {
    "@yharness/util-crypto": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@yharness/agent": "workspace:*",
    "@yharness/attachment": "workspace:*",
    "@yharness/brand": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/cordis": "workspace:~"
  }
}

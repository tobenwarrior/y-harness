{
  "name": "@yharness/user-approval",
  "description": "User-approval seam (ctx.approval) for the Y Harness: one-shot permission decisions dispatched to composed answerers over the approval/request waterfall, fail-closed by default",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/interaction/user-approval"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/agent": "workspace:*",
    "@yharness/brand": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/cordis": "workspace:~"
  },
  "dependencies": {
    "@yharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@yharness/agent": "workspace:*",
    "@yharness/brand": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/cordis": "workspace:~"
  }
}

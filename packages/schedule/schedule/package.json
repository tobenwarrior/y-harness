{
  "name": "@yharness/schedule",
  "description": "Host-wide durable reminders with shared management and original-Session delivery",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/schedule/schedule"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/agent": "workspace:*",
    "@yharness/api-session-controller": "workspace:*",
    "@yharness/brand": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-persistence": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/storage-domain": "workspace:*",
    "@yharness/subagent": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/workspace": "workspace:*",
    "@yharness/cordis": "workspace:~"
  },
  "dependencies": {
    "@yharness/schemastery": "workspace:~",
    "@js-temporal/polyfill": "0.5.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@yharness/cordis-plugin-loader": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/agent-loop": "workspace:*",
    "@yharness/agent-loop-testkit": "workspace:*",
    "@yharness/api-session-controller": "workspace:*",
    "@yharness/brand": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-persistence": "workspace:*",
    "@yharness/session-persistence-jsonl": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/storage": "workspace:*",
    "@yharness/storage-domain": "workspace:*",
    "@yharness/storage-json": "workspace:*",
    "@yharness/subagent": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/workspace": "workspace:*",
    "@yharness/cordis": "workspace:~"
  }
}

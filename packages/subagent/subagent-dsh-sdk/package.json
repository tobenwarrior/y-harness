{
  "name": "@yharness/subagent-dsh-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child Y Harness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/subagent/subagent-dsh-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/sdk-client": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/subagent": "workspace:*",
    "@yharness/subprocess": "workspace:*"
  },
  "dependencies": {
    "@yharness/brand": "workspace:*",
    "@yharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/cordis-plugin-loader": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/agent-instructions": "workspace:*",
    "@yharness/app-boot": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/llm-deepseek": "workspace:*",
    "@yharness/llm-deepseek-api-key": "workspace:*",
    "@yharness/loader-smoke": "workspace:*",
    "@yharness/sdk-client": "workspace:*",
    "@yharness/sdk-protocol": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-checkpoint-policy": "workspace:*",
    "@yharness/session-persistence-jsonl": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/skill-filesystem": "workspace:*",
    "@yharness/subagent": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/tool-subagent": "workspace:*"
  }
}

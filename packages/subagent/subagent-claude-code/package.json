{
  "name": "@yharness/subagent-claude-code",
  "description": "Claude Code one-shot subagents and optional normal root turns over the official Agent SDK",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/subagent/subagent-claude-code"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/llm": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/subagent": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/timeout": "workspace:*",
    "@yharness/agent": "workspace:*",
    "@yharness/sandbox": "workspace:*",
    "@yharness/sandbox-policy": "workspace:*",
    "@yharness/user-approval": "workspace:*",
    "@yharness/skill-library": "workspace:*",
    "@yharness/workspace": "workspace:*"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@anthropic-ai/sdk": "0.93.0",
    "@yharness/brand": "workspace:*",
    "@yharness/schemastery": "workspace:~",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3",
    "@yharness/util-values": "workspace:*"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/app-boot": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/loader-smoke": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-checkpoint-policy": "workspace:*",
    "@yharness/session-persistence-jsonl": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/subagent": "workspace:*",
    "@yharness/subagent-codex": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/subprocess-local": "workspace:*",
    "@yharness/timeout": "workspace:*",
    "@yharness/tool-jobs": "workspace:*",
    "@yharness/tool-subagent": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/sandbox": "workspace:*",
    "@yharness/sandbox-policy": "workspace:*",
    "@yharness/user-approval": "workspace:*",
    "@yharness/skill-library": "workspace:*",
    "@yharness/workspace": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@yharness/agent": {
      "optional": true
    },
    "@yharness/sandbox": {
      "optional": true
    },
    "@yharness/sandbox-policy": {
      "optional": true
    },
    "@yharness/user-approval": {
      "optional": true
    },
    "@yharness/skill-library": {
      "optional": true
    },
    "@yharness/workspace": {
      "optional": true
    }
  }
}

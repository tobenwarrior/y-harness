{
  "name": "@yharness/webhook",
  "description": "Fire-and-forget webhook rule runtime that creates Workspace-backed Y Harness Sessions",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/webhook/webhook"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/agent-default-model": "workspace:*",
    "@yharness/agent-preset-registry": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/permission-presets": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-title": "workspace:*",
    "@yharness/workspace": "workspace:*"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/cordis-plugin-include": "workspace:~",
    "@yharness/cordis-plugin-loader": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/agent-default-model": "workspace:*",
    "@yharness/agent-preset-registry": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/permission-presets": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-title": "workspace:*",
    "@yharness/workspace": "workspace:*"
  },
  "dependencies": {
    "@yharness/brand": "workspace:*",
    "@yharness/util-values": "workspace:*"
  }
}

{
  "name": "@yharness/jobs-local",
  "description": "Process-local implementation of the Y Harness background job registry seam",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/jobs/jobs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/agent": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/jobs": "workspace:*",
    "@yharness/timeout": "workspace:*",
    "@yharness/cordis": "workspace:~"
  },
  "dependencies": {
    "@yharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@yharness/cordis-plugin-include": "workspace:~",
    "@yharness/cordis-plugin-loader": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/agent-loop-testkit": "workspace:*",
    "@yharness/brand": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/jobs": "workspace:*",
    "@yharness/timeout": "workspace:*",
    "@yharness/cordis": "workspace:~"
  }
}

{
  "name": "@yharness/settings",
  "description": "Abstract user-settings seam (ctx.settings) for the Y Harness",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/settings/settings"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/brand": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/brand": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/schemastery": "workspace:~",
    "@yharness/cordis-plugin-timer": "workspace:~",
    "@yharness/app-boot": "workspace:*",
    "@yharness/hmr": "workspace:*",
    "@yharness/agent-default-model": "workspace:*",
    "yaml": "^2.8.1"
  },
  "dependencies": {
    "@yharness/util-values": "workspace:*",
    "@yharness/config-editor": "workspace:*",
    "@yharness/cordis-plugin-loader": "workspace:~",
    "@yharness/cosmokit": "workspace:~",
    "yaml": "^2.8.1"
  }
}

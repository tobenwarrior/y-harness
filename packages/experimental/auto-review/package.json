{
  "name": "@yharness/experimental-auto-review",
  "description": "Per-tool LLM authorization review for the Y Harness Auto permission preset",
  "version": "0.2.1-rc.2",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/agent": "workspace:*",
    "@yharness/agent-instructions": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/permission-presets": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/cordis": "workspace:~"
  },
  "dependencies": {
    "@yharness/util-values": "workspace:*"
  },
  "devDependencies": {
    "@yharness/agent": "workspace:*",
    "@yharness/agent-instructions": "workspace:*",
    "@yharness/agent-loop": "workspace:*",
    "@yharness/agent-loop-testkit": "workspace:*",
    "@yharness/bash-sandbox": "workspace:*",
    "@yharness/compaction": "workspace:*",
    "@yharness/fs-local": "workspace:*",
    "@yharness/fs-observation-policy": "workspace:*",
    "@yharness/fs-sandbox": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/llm-deepseek": "workspace:*",
    "@yharness/llm-deepseek-api-key": "workspace:*",
    "@yharness/permission-presets": "workspace:*",
    "@yharness/ptc-runtime-node": "workspace:*",
    "@yharness/sandbox": "workspace:*",
    "@yharness/sandbox-policy": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/shell": "workspace:*",
    "@yharness/shell-env": "workspace:*",
    "@yharness/subagent": "workspace:*",
    "@yharness/subprocess-local": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/tool-bash": "workspace:*",
    "@yharness/tool-fs": "workspace:*",
    "@yharness/tool-subagent": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/user-approval": "workspace:*",
    "@yharness/cordis": "workspace:~"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

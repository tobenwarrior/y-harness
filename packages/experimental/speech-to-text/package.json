{
  "name": "@yharness/experimental-speech-to-text",
  "description": "Experimental speech recognition with independently selectable providers",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/experimental/speech-to-text"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./wave": {
      "types": "./lib/types/wave.d.ts",
      "default": "./lib/types/wave.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@yharness/brand": "workspace:*",
    "@yharness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/settings": "workspace:*",
    "@yharness/cordis-plugin-loader": "workspace:~"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/app-boot": "workspace:*",
    "@yharness/config-editor": "workspace:*",
    "@yharness/settings": "workspace:*",
    "@yharness/cordis-plugin-loader": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@yharness/cordis-plugin-loader": {
      "optional": true
    }
  }
}

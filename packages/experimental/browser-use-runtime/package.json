{
  "name": "@yharness/experimental-browser-use-runtime",
  "description": "Session-owned browser resource lifecycles and MCP integration for experimental providers",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/experimental/browser-use-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./mcp": {
      "types": "./lib/types/mcp.d.ts",
      "default": "./lib/types/mcp.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/browser-use": "workspace:*",
    "@yharness/mcp-client": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/system-prompt": "workspace:*"
  },
  "dependencies": {
    "@yharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/browser-use": "workspace:*",
    "@yharness/mcp-client": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/agent-loop-testkit": "workspace:*",
    "@yharness/agent-loop": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/mcp-resources": "workspace:*",
    "@yharness/ptc-runtime": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/cordis-plugin-loader": "workspace:~",
    "@yharness/cordis-plugin-include": "workspace:~",
    "@yharness/attachment-local": "workspace:*",
    "@yharness/session-persistence-jsonl": "workspace:*"
  }

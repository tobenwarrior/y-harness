{
  "name": "@yharness/experimental-claude-code-mods",
  "description": "Experimental bridge: load Claude Code mods (hooks modules) and run their hook chains on Y Harness extension points",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/experimental/claude-code-mods"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./testing": {
      "types": "./lib/types/testing.d.ts",
      "default": "./lib/types/testing.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./examples/*": "./examples/*",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@yharness/util-crypto": "workspace:*",
    "@yharness/util-values": "workspace:*",
    "@yharness/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/commands": "workspace:*",
    "@yharness/fs": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/storage-domain": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/token-meter": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/user-questions": "workspace:*"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/cordis-plugin-include": "workspace:~",
    "@yharness/cordis-plugin-loader": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/agent-loop": "workspace:*",
    "@yharness/agent-loop-testkit": "workspace:*",
    "@yharness/attachment": "workspace:*",
    "@yharness/commands": "workspace:*",
    "@yharness/fs": "workspace:*",
    "@yharness/fs-local": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/storage": "workspace:*",
    "@yharness/storage-domain": "workspace:*",
    "@yharness/storage-json": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/subprocess-local": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/token-meter": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/user-questions": "workspace:*"
  }
}

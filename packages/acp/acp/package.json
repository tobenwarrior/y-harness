{
  "name": "@yharness/acp",
  "description": "Automation-only Agent Client Protocol server for driving Y Harness agents over JSON-RPC stdio",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@yharness/brand": "workspace:*",
    "@yharness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/attachment": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/mcp-client": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-persistence": "workspace:*",
    "@yharness/token-meter": "workspace:*",
    "@yharness/user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@yharness/token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/agent-loop": "workspace:*",
    "@yharness/agent-loop-testkit": "workspace:*",
    "@yharness/attachment": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/mcp-client": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-persistence": "workspace:*",
    "@yharness/session-persistence-jsonl": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/token-meter": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/user-approval": "workspace:*"
  }
}

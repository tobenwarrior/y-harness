{
  "name": "@yharness/agent",
  "description": "Agent interface, registry, initiator scope, and event vocabulary for the Y Harness",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/core/agent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/llm": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/util-values": "workspace:*",
    "@yharness/workspace": "workspace:*",
    "@yharness/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@yharness/workspace": {
      "optional": true
    }
  },
  "devDependencies": {
    "@yharness/llm": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/typert-registry": "workspace:*",
    "@yharness/util-values": "workspace:*",
    "@yharness/workspace": "workspace:*",
    "@yharness/cordis": "workspace:~"
  }
}

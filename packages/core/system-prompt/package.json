{
  "name": "@yharness/system-prompt",
  "description": "System prompt assembly registry for the Y Harness",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/core/system-prompt"
  },
  "type": "module",
  "main": "lib/index.js",

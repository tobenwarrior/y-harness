{
  "name": "@yharness/sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@yharness/cordis-plugin-timer": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/agent-loop": "workspace:*",
    "@yharness/deepseek-llm-api-extensions": "workspace:*",
    "@yharness/jobs-local": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/llm-deepseek-api-key": "workspace:*",
    "@yharness/llm-retry": "workspace:*",
    "@yharness/mcp-resources": "workspace:*",
    "@yharness/plugin-package-inventory-deepseek": "workspace:*",
    "@yharness/sandbox-local": "workspace:*",
    "@yharness/sandbox-policy": "workspace:*",
    "@yharness/sdk-app": "workspace:*",
    "@yharness/sdk-jsonrpc-server": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-log-deepseek": "workspace:*",
    "@yharness/session-persistence-jsonl": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/session-title": "workspace:*",
    "@yharness/subprocess-local": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/terminal": "workspace:*",
    "@yharness/terminal-bash": "workspace:*",
    "@yharness/tool-bash-persistent": "workspace:*",
    "@yharness/tool-pwsh-persistent": "workspace:*",
    "@yharness/tools": "workspace:*"
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~"
  }
}

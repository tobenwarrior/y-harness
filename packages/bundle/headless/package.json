{
  "name": "@yharness/headless",
  "description": "The Y Harness one-shot bundle: a direct core Agent/Session runner over yharness-base with no Host, HTTP, or browser layer",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/bundle/headless"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/json-stream-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@yharness/brand": "workspace:*",
    "@yharness/cmdline": "workspace:*",
    "@yharness/util-values": "workspace:*",
    "@yharness/schemastery": "workspace:~",
    "commander": "^15.0.0"
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/cordis-plugin-loader": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/agent-default-model": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-query": "workspace:*",
    "@yharness/fs": "workspace:*"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/cordis-plugin-loader": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/agent-default-model": "workspace:*",
    "@yharness/agent-loop": "workspace:*",
    "@yharness/agent-loop-testkit": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-query": "workspace:*",
    "@yharness/fs": "workspace:*"
  }
}

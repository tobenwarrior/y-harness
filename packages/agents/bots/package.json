{
  "name": "@yharness/bots",
  "description": "Y Harness durable user-owned Bot roster with one persistent Session per Bot",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/agents/bots"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@yharness/brand": "workspace:*",
    "@yharness/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/attachment": "workspace:*",
    "@yharness/agent": "workspace:*",
    "@yharness/api-session-controller": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/subagent": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/storage-domain": "workspace:*",
    "@yharness/typert-protocol": "workspace:*"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/attachment": "workspace:*",
    "@yharness/agent": "workspace:*",
    "@yharness/api-session-controller": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/subagent": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/storage": "workspace:*",
    "@yharness/storage-domain": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/cordis-plugin-loader": "workspace:~"
  }
}

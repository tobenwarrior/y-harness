{
  "name": "@yharness/ssh",
  "description": "Shared OpenSSH connection and versioned POSIX remote helper",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/ssh/ssh"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./helper": {
      "types": "./lib/types/helper-entry.d.ts",
      "default": "./lib/helper.js"
    },
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./schemas": {
      "types": "./lib/types/schemas.d.ts",
      "default": "./lib/schemas.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/helper.js",
    "lib/protocol.js",
    "lib/schemas.js",
    "lib/protocol-*.js",
    "lib/schemas-*.js",
    "lib/stream-security-*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/fs": "workspace:*",
    "@yharness/fs-local": "workspace:*",
    "@yharness/fs-sandbox": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/subprocess-local": "workspace:*",
    "@yharness/sandbox": "workspace:*",
    "@yharness/sandbox-local": "workspace:*",
    "@yharness/sandbox-policy": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/brand": "workspace:*"
  },
  "dependencies": {
    "@yharness/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/fs": "workspace:*",
    "@yharness/fs-local": "workspace:*",
    "@yharness/fs-sandbox": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/subprocess-local": "workspace:*",
    "@yharness/sandbox": "workspace:*",
    "@yharness/sandbox-local": "workspace:*",
    "@yharness/sandbox-policy": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/ptc-runtime-node": "workspace:*",
    "@yharness/fs-ssh": "workspace:*",
    "@yharness/subprocess-ssh": "workspace:*",
    "@yharness/sandbox-ssh": "workspace:*",
    "@yharness/lsp": "workspace:*",
    "@yharness/lsp-stdio": "workspace:*",
    "@yharness/brand": "workspace:*"
  }
}

{
  "name": "@yharness/sdk-client",
  "description": "TypeScript client SDK for driving a Y Harness runtime subprocess over stdio JSON-RPC: the DeepSeekHarness high-level turns API and the lower-level HarnessClient",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@yharness/cli": "workspace:*"
  },
  "peerDependencies": {
    "@yharness/llm": "workspace:*",
    "@yharness/sdk-protocol": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@yharness/llm": "workspace:*",
    "@yharness/sdk-protocol": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/cordis": "workspace:~"
  }
}

{
  "name": "@yharness/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Y Harness SDK clients",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@yharness/brand": "workspace:*",
    "@yharness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/attachment": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/llm-deepseek-api-key": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/sdk-protocol": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/subagent": "workspace:*"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/cordis-plugin-loader": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/agent-loop": "workspace:*",
    "@yharness/agent-loop-testkit": "workspace:*",
    "@yharness/attachment": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/llm-deepseek-api-key": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/sdk-protocol": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-persistence-jsonl": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/subagent": "workspace:*"
  }
}

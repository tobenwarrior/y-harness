{
  "name": "@yharness/session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/context/session-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@yharness/brand": "workspace:*",
    "@yharness/util-values": "workspace:*",
    "@yharness/schemastery": "workspace:~",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/compaction": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/output-retention": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/session-projection-cache": "workspace:*",
    "@yharness/session-query": "workspace:*",
    "@yharness/session-title": "workspace:*",
    "@yharness/spill": "workspace:*",
    "@yharness/subagent": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/typert-protocol": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@yharness/spill": {
      "optional": true
    },
    "@yharness/session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/cordis-plugin-include": "workspace:~",
    "@yharness/cordis-plugin-loader": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/compaction": "workspace:*",
    "@yharness/fs-local": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/output-retention": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/session-projection-cache": "workspace:*",
    "@yharness/session-query": "workspace:*",
    "@yharness/session-query-sqlite": "workspace:*",
    "@yharness/session-title": "workspace:*",
    "@yharness/spill": "workspace:*",
    "@yharness/subagent": "workspace:*",
    "@yharness/spill-local": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/tool-fs": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/typert-protocol": "workspace:*"
  }
}

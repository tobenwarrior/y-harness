{
  "name": "@yharness/tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the Y Harness web capability seam (ctx.web)",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/llm": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/web": "workspace:*"
  },
  "dependencies": {
    "@yharness/util-values": "workspace:*",
    "@yharness/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/spill-local": "workspace:*",
    "@yharness/spill-policy": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/tool-call-timeout-policy": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/web": "workspace:*",
    "@yharness/web-fetch-http": "workspace:*",
    "@yharness/web-search-exa": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@yharness/scope": "workspace:*",
    "@yharness/token-meter": "workspace:*"
  }
}

{
  "name": "@yharness/command-feedback",
  "description": "Log-only session feedback: the record event, the sessionFeedback Host Remote, and the human-facing slash command",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/feedback/command-feedback"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/commands": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/anonymous-user-id": "workspace:*",
    "@yharness/cordis": "workspace:~",
    "@yharness/typert-protocol": "workspace:*"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@yharness/cordis-plugin-include": "workspace:~",
    "@yharness/cordis-plugin-loader": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/agent-loop-testkit": "workspace:*",
    "@yharness/commands": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/anonymous-user-id": "workspace:*",
    "@yharness/cordis": "workspace:~",
    "@yharness/typert-protocol": "workspace:*"
  }
}

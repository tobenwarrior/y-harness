{
  "name": "@yharness/ptc-runtime-node",
  "description": "Sandboxed Node process implementation of the Y Harness PTC execution capability",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/ptc-runtime/ptc-runtime-node"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./process": {
      "types": "./lib/types/process-entry.d.ts",
      "default": "./lib/process.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/process.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/ptc-runtime": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/timeout": "workspace:*",
    "@yharness/fs": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/sandbox": "workspace:*",
    "@yharness/sandbox-policy": "workspace:*"
  },
  "dependencies": {
    "@yharness/util-values": "workspace:*",
    "@yharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/ptc-runtime": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/timeout": "workspace:*",
    "@yharness/fs": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/sandbox": "workspace:*",
    "@yharness/sandbox-policy": "workspace:*",
    "@yharness/fs-local": "workspace:*",
    "@yharness/subprocess-local": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/sandbox-local": "workspace:*"
  }
}

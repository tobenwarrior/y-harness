{
  "name": "@yharness/client-ui-compound-update",
  "description": "Compound skills update indicator and update-steps panel for the Web client",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/client/ui-compound-update"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@yharness/client-locale",
        "@yharness/client-ui-layout",
        "@yharness/client-ui-renderer",
        "@yharness/client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/client-locale": "workspace:*",
    "@yharness/client-store": "workspace:*",
    "@yharness/client-test-runtime": "workspace:*",
    "@yharness/client-ui-layout": "workspace:*",
    "@yharness/client-ui-primitives": "workspace:*",
    "@yharness/client-ui-renderer": "workspace:*",
    "@yharness/client-ui-sidebar": "workspace:*",
    "@yharness/client-ui-slots": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0"
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  }
}

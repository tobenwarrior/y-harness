{
  "name": "@yharness/client-ui-settings-web-search",
  "description": "Settings page of the DeepSeek web-search provider on the dsh web client's Plugins page: its API key, endpoint, and per-request search budget",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/client/ui-settings-web-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@yharness/client-locale",
        "@yharness/client-ui-settings",
        "@yharness/client-ui-plugin-manager",
        "@yharness/api-remotes"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@yharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/api-remotes": "workspace:*",
    "@yharness/client-locale": "workspace:*",
    "@yharness/client-store": "workspace:*",
    "@yharness/client-test-runtime": "workspace:*",
    "@yharness/client-ui-plugin-manager": "workspace:*",
    "@yharness/client-ui-primitives": "workspace:*",
    "@yharness/client-ui-renderer": "workspace:*",
    "@yharness/client-ui-settings": "workspace:*",
    "@yharness/client-ui-slots": "workspace:*",
    "react": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}

{
  "name": "@yharness/client-ui-tool",
  "description": "Client Tool call-tree renderer and keyed per-tool presentation slot",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/client/ui-tool"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@yharness/api-workspace-controller",
        "@yharness/client-connection",
        "@yharness/client-locale",
        "@yharness/client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@yharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@yharness/spill-policy": "workspace:*",
    "@yharness/agent": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/tool-jobs": "workspace:*",
    "@yharness/tool-session-query": "workspace:*",
    "@yharness/tool-terminal": "workspace:*",
    "@yharness/spill": "workspace:*",
    "@yharness/cordis": "workspace:~",
    "@yharness/api-remotes": "workspace:*",
    "@yharness/client-connection": "workspace:*",
    "@yharness/client-locale": "workspace:*",
    "@yharness/client-test-runtime": "workspace:*",
    "@yharness/client-ui-conversation": "workspace:*",
    "@yharness/client-ui-primitives": "workspace:*",
    "@yharness/client-ui-slots": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@yharness/api-workspace-controller": "workspace:*",
    "@yharness/client-ui-chat": "workspace:*",
    "@yharness/client-ui-renderer": "workspace:*",
    "@yharness/client-ui-session": "workspace:*",
    "@yharness/util-values": "workspace:*",
    "@yharness/util-workspace-path": "workspace:*",
    "@yharness/attachment": "workspace:*",
    "clsx": "^2.0.0",
    "@yharness/ptc-runtime": "workspace:*",
    "@yharness/token-meter": "workspace:*",
    "@yharness/user-questions": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}

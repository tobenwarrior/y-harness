{
  "name": "@yharness/client-ui-skill-library",
  "description": "Scoped skill inventory, reversible maintenance, and explicit relationship graph for the Y Harness client",
  "version": "0.2.1-rc.2",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/tobenwarrior/y-harness.git", "directory": "packages/client/ui-skill-library" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": { "client": { "inject": ["@yharness/api-remotes", "@yharness/client-locale", "@yharness/client-ui-layout", "@yharness/client-ui-sidebar"], "platform": "web" } },
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "license": "MIT",
  "peerDependencies": { "@yharness/cordis": "workspace:~" },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/api-remotes": "workspace:*",
    "@yharness/client-locale": "workspace:*",
    "@yharness/client-store": "workspace:*",
    "@yharness/client-test-runtime": "workspace:*",
    "@yharness/client-ui-layout": "workspace:*",
    "@yharness/client-ui-primitives": "workspace:*",
    "@yharness/client-ui-renderer": "workspace:*",
    "@yharness/client-ui-sidebar": "workspace:*",
    "@yharness/client-ui-settings-models": "workspace:*",
    "@yharness/client-ui-slots": "workspace:*",
    "@yharness/skill-library": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "^2.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.d.ts"]
}

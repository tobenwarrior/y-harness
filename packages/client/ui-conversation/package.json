{
  "name": "@yharness/client-ui-conversation",
  "description": "Target-neutral Conversation assembly, shell, composer, queue, and view navigation",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/client/ui-conversation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@yharness/api-session-controller",
        "@yharness/client-file-upload",
        "@yharness/client-locale",
        "@yharness/client-ui-layout",
        "@yharness/client-ui-renderer",
        "@yharness/client-ui-session",
        "@yharness/client-ui-settings",
        "@yharness/client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@yharness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/api-remotes": "workspace:*",
    "@yharness/api-session-controller": "workspace:*",
    "@yharness/api-workspace-controller": "workspace:*",
    "@yharness/attachment": "workspace:*",
    "@yharness/brand": "workspace:*",
    "@yharness/client-locale": "workspace:*",
    "@yharness/client-file-upload": "workspace:*",
    "@yharness/client-store": "workspace:*",
    "@yharness/client-test-runtime": "workspace:*",
    "@yharness/client-ui-layout": "workspace:*",
    "@yharness/client-ui-primitives": "workspace:*",
    "@yharness/client-ui-renderer": "workspace:*",
    "@yharness/client-ui-session": "workspace:*",
    "@yharness/client-ui-settings": "workspace:*",
    "@yharness/client-ui-workspace": "workspace:*",
    "@yharness/client-ui-slots": "workspace:*",
    "@yharness/commands": "workspace:*",
    "@yharness/goal": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/llm-retry": "workspace:*",
    "@yharness/plan-mode": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/util-values": "workspace:*",
    "@yharness/token-meter": "workspace:*",
    "@yharness/tool-todo": "workspace:*",
    "@yharness/util-crypto": "workspace:*",
    "@yharness/workspace": "workspace:*",
    "@yharness/file-reference": "workspace:*",
    "@yharness/util-workspace-path": "workspace:*",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@lexical/headless": "^0.49.0",
    "react-dom": "^18.2.0",
    "@types/react-dom": "~18.3.0",
    "zod": "^4.4.3",
    "lexical": "^0.49.0",
    "clsx": "^2.0.0",
    "@lexical/utils": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/history": "^0.49.0",
    "@yharness/agent": "workspace:*",
    "@yharness/settings": "workspace:*",
    "@yharness/client-shortcuts": "workspace:*",
    "@yharness/client-product-analytics": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}

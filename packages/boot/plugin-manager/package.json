{
  "name": "@yharness/plugin-manager",
  "description": "Current-profile plugin and bundle management shared by dsh CLI, Web and agent tools",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/boot/plugin-manager"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./registry": {
      "types": "./lib/types/registry.d.ts",
      "default": "./lib/types/registry.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./operations": {
      "types": "./lib/types/operations.d.ts",
      "default": "./lib/types/operations.js"
    },
    "./tools": {
      "types": "./lib/types/tools.d.ts",
      "default": "./lib/types/tools.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@yharness/app-boot": "workspace:*",
    "@yharness/atomic-write": "workspace:*",
    "@yharness/schemastery": "workspace:~",
    "execa": "^10.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@yharness/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/cordis-plugin-loader": "workspace:~",
    "@yharness/host-plugin-inventory": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/hmr": "workspace:*",
    "@yharness/brand": "workspace:*",
    "@yharness/sandbox-policy": "workspace:*",
    "@yharness/sandbox": "workspace:*",
    "@yharness/user-approval": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@yharness/hmr": {
      "optional": true
    },
    "@yharness/user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "chokidar": "^4.0.3",
    "@yharness/package-manifest": "workspace:*",
    "@yharness/cordis": "workspace:~",
    "@yharness/cordis-plugin-loader": "workspace:~",
    "@yharness/host-plugin-inventory": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/typert-protocol": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/hmr": "workspace:*",
    "@yharness/cordis-plugin-timer": "workspace:~",
    "@yharness/brand": "workspace:*",
    "@yharness/sandbox-policy": "workspace:*",
    "@yharness/agent": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/sandbox": "workspace:*",
    "@yharness/user-approval": "workspace:*"
  }
}

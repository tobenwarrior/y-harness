{
  "name": "@yharness/mcp-client",
  "description": "MCP client bridge: connects to MCP servers and registers their tools on ctx.tools",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/mcp/mcp-client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/attachment": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/timeout": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/cordis": "workspace:~",
    "@yharness/mcp-resources": "workspace:*",
    "@yharness/system-prompt": "workspace:*"
  },
  "dependencies": {
    "@yharness/schemastery": "workspace:~",
    "@modelcontextprotocol/client": "2.0.0",
    "@yharness/util-values": "workspace:*"
  },
  "devDependencies": {
    "@yharness/attachment": "workspace:*",
    "@yharness/attachment-local": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/scope": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/timeout": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@modelcontextprotocol/server-everything": "^2026.7.4",
    "@modelcontextprotocol/server-filesystem": "^2026.7.4",
    "@yharness/cordis": "workspace:~",
    "@yharness/http-proxy": "workspace:*",
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "zod": "^4.4.3",
    "@yharness/mcp-resources": "workspace:*",
    "@yharness/system-prompt": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@yharness/mcp-resources": {
      "optional": true
    },
    "@yharness/system-prompt": {
      "optional": true
    }
  }
}

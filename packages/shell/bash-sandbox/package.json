{
  "name": "@yharness/bash-sandbox",
  "description": "Sandbox-consuming implementation of the Y Harness bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/shell/bash-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/shell": "workspace:*",
    "@yharness/bash-local": "workspace:*",
    "@yharness/sandbox": "workspace:*",
    "@yharness/sandbox-policy": "workspace:*",
    "@yharness/cordis": "workspace:~"
  },
  "devDependencies": {
    "@yharness/shell": "workspace:*",
    "@yharness/bash-local": "workspace:*",
    "@yharness/subprocess-local": "workspace:*",
    "@yharness/sandbox": "workspace:*",
    "@yharness/sandbox-local": "workspace:*",
    "@yharness/sandbox-policy": "workspace:*",
    "@yharness/cordis": "workspace:~",
    "@yharness/node-addon-system": "workspace:~",
    "@yharness/session-projection": "workspace:*"
  }
}

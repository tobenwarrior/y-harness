{
  "name": "@yharness/lsp-stdio",
  "description": "Generic stdio language-server provider for the Y Harness LSP capability seam (ctx.lsp) — spawns configured servers, translates JSON-RPC, and serves transient-open goToDefinition/findReferences/goToImplementation/hover queries in the host filesystem namespace",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/lsp/lsp-stdio"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/brand": "workspace:*",
    "@yharness/fs": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/lsp": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/timeout": "workspace:*"
  },
  "dependencies": {
    "@yharness/util-values": "workspace:*",
    "@yharness/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/brand": "workspace:*",
    "@yharness/fs": "workspace:*",
    "@yharness/fs-local": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/lsp": "workspace:*",
    "@yharness/subprocess": "workspace:*",
    "@yharness/subprocess-local": "workspace:*",
    "@yharness/timeout": "workspace:*",
    "typescript": "^6.0.3",
    "typescript-language-server": "^5.0.0"
  }
}

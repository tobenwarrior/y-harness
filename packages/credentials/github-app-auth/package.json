{
  "name": "@yharness/github-app-auth",
  "description": "Host-only GitHub App device authorization for the GitHub MCP server",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/credentials/github-app-auth"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/authorization": "workspace:*",
    "@yharness/cordis": "workspace:~",
    "@yharness/credentials": "workspace:*"
  },
  "devDependencies": {
    "@yharness/authorization": "workspace:*",
    "@yharness/cordis": "workspace:~",
    "@yharness/credentials": "workspace:*"
  },
  "dependencies": {
    "@yharness/schemastery": "workspace:~"
  }
}

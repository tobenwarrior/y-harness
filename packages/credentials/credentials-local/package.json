{
  "name": "@yharness/credentials-local",
  "description": "File-backed credentials provider ($DSH_HOME/.env under the live process environment) for the Y Harness",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/credentials/credentials-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/atomic-write": "workspace:*",
    "@yharness/credentials": "workspace:*",
    "@yharness/launch-environment": "workspace:*",
    "@yharness/home-paths": "workspace:*",
    "@yharness/cordis": "workspace:~"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "@yharness/schemastery": "workspace:~",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@yharness/atomic-write": "workspace:*",
    "@yharness/credentials": "workspace:*",
    "@yharness/launch-environment": "workspace:*",
    "@yharness/home-paths": "workspace:*",
    "@yharness/cordis": "workspace:~"
  }
}

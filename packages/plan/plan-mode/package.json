{
  "name": "@yharness/plan-mode",
  "description": "Logged per-agent plan mode with deployment guidance, a direct slash command, and a user-reviewed exit",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/plan/plan-mode"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@yharness/agent": "workspace:*",
    "@yharness/commands": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/user-questions": "workspace:*",
    "@yharness/cordis": "workspace:~"
  },
  "peerDependenciesMeta": {
    "@yharness/commands": {
      "optional": true
    }
  },
  "dependencies": {
    "@yharness/brand": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@yharness/agent": "workspace:*",
    "@yharness/agent-loop": "workspace:*",
    "@yharness/ptc-runtime": "workspace:*",
    "@yharness/commands": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/user-questions": "workspace:*",
    "@yharness/cordis": "workspace:~"
  }
}

{
  "name": "@yharness/tool-present",
  "description": "Explicit workspace file delivery declarations for the Y Harness",
  "version": "0.2.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobenwarrior/y-harness.git",
    "directory": "packages/deliverables/tool-present"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@yharness/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/fs": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/tools": "workspace:*"
  },
  "devDependencies": {
    "@yharness/cordis": "workspace:~",
    "@yharness/agent": "workspace:*",
    "@yharness/fs": "workspace:*",
    "@yharness/llm": "workspace:*",
    "@yharness/session": "workspace:*",
    "@yharness/session-projection": "workspace:*",
    "@yharness/tools": "workspace:*",
    "@yharness/agent-loop": "workspace:*",
    "@yharness/agent-loop-testkit": "workspace:*",
    "@yharness/fs-local": "workspace:*",
    "@yharness/system-prompt": "workspace:*",
    "@yharness/scope": "workspace:*"
  }
}
